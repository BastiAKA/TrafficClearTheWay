<Publish>
	<!--DEV CHANNEL. Separate mod page from the release (151583) - keep it that way.
	    ModId is EMPTY on purpose: publish once with PublishDev.pubxml, paste the NEW
	    id returned here, then use UpdateDev.pubxml. Never paste the release id.-->
	<!--This PublishConfiguration.xml is required to publish any mod on Paradox Mods website and is part of the CSII toolchain-->
	<!--Id must be set in order to update existed mod. it is not required for publishing mod for the first time-->
	<ModId Value="" />
	<!--Name of the mod to display to players-->
	<DisplayName Value="Traffic: Clear the Way [DEV]" />
	<!--Short description of the mod-->
	<ShortDescription Value="DEV TEST BUILD of Traffic: Clear the Way. Unstable - do not use on a city you care about." />
	<!--Long description of the mod. Single line or multi line. Supports minimal markdown subset-->
	<LongDescription>
⚠️ **This is the development build of _Traffic: Clear the Way_. It is not the mod you want.**

Install the normal release instead - this page exists so testers can try changes before they ship.

- Expect rough edges: unfinished behaviour, debug logging, values that change between uploads.
- Do **not** run it on a city you care about. Keep a backup save.
- Never run it alongside the release version - both register the same systems.

Feedback on a dev build is most useful with `Logs/ClearTheWay.log` attached (switch on "Verbose logging" in the options first).

Release version: https://mods.paradoxplaza.com/mods/151583/Windows
</LongDescription>

	<!--Thumbnail-->
	<Thumbnail Value="Properties/Thumbnail.jpg" />
	<!--Screenshot, can be set multiple times-->
	<Screenshot Value="Properties/Screenshot1.jpg" />
	<Screenshot Value="Properties/Screenshot2.jpg" />
	<Screenshot Value="Properties/Screenshot3.jpg" />
	<!--Tag, can be set multiple times-->
	<Tag Value="Code Mod" />
	<!--Link to the forum post where the mod can be discussed-->
	<ForumLink Value="" />
	<!--Version of the mod-->
	<ModVersion Value="0.1.12" />
	<!--Recommended version of the base game to use the mod-->
	<GameVersion Value="1.6.*" />
	<!--Dependency for the mod, can be set multiple times-->
	<Dependency Id="" />
	<!--Required DLC, can be set multiple times. Supported values are "Landmark Buildings", "San Fransisco Set", "Beach Properties", "Urban Promenades", "Modern Architecture"-->
	<RequiredDLC Value="" />
	<!--Change log for new version. Single line or multi line. Supports minimal markdown subset-->
	<ChangeLog>
Development snapshot - see the session notes for what changed. Not a release.
</ChangeLog>
	<!--External link, can be set multiple times. supported types are "discord", "github", "youtube", "twitch", "x", "paypal", "patreon", "buymeacoffee", "kofi", "crowdin", "gitlab", "gofundme"-->
	<ExternalLink Type="" Url="" />
	<!--Supported values Public, Private, Unlisted-->
	<AccessLevel Value="Unlisted" />
</Publish>
