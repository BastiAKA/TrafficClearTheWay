<?xml version="1.0" encoding="utf-8"?>
<!-- Ship new code. Bump ModVersion in PublishConfiguration.xml (and Version in
     the csproj to match) and write the ChangeLog first. Unlike Update this does
     build, so the freshly built DLL is what gets uploaded. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <PublishDir>bin\Publish</PublishDir>
    <ModPublisherCommand>NewVersion</ModPublisherCommand>
  </PropertyGroup>
</Project>
