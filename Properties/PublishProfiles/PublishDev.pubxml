<?xml version="1.0" encoding="utf-8"?>
<!-- DEV channel, FIRST upload only: creates a SEPARATE mod page and mints its own
     ModId. Paste that id into PublishConfigurationDev.xml (NOT the release id
     151583), then use UpdateDev.pubxml from then on. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <PublishDir>bin\PublishDev</PublishDir>
    <ModPublisherCommand>Publish</ModPublisherCommand>
    <!--The whole point of the dev channel: a different configuration file, so the
        release ModId in Properties/PublishConfiguration.xml can never be touched.-->
    <PublishConfigurationPath>Properties\PublishConfigurationDev.xml</PublishConfigurationPath>
  </PropertyGroup>
</Project>
