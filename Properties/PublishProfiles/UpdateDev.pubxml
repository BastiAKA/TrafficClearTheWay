<?xml version="1.0" encoding="utf-8"?>
<!-- DEV channel, re-upload without building (build Release first).
     Requires ModId in PublishConfigurationDev.xml, else it creates a THIRD mod page. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <PublishDir>bin\PublishDev</PublishDir>
    <ModPublisherCommand>Update</ModPublisherCommand>
    <!--The whole point of the dev channel: a different configuration file, so the
        release ModId in Properties/PublishConfiguration.xml can never be touched.-->
    <PublishConfigurationPath>Properties\PublishConfigurationDev.xml</PublishConfigurationPath>
  </PropertyGroup>
</Project>
