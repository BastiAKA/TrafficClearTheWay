<?xml version="1.0" encoding="utf-8"?>
<!-- DEV channel, ship new code. Builds first, so the fresh DLL is uploaded.
     Requires ModId to be set in PublishConfigurationDev.xml. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <PublishDir>bin\PublishDev</PublishDir>
    <ModPublisherCommand>NewVersion</ModPublisherCommand>
    <!--The whole point of the dev channel: a different configuration file, so the
        release ModId in Properties/PublishConfiguration.xml can never be touched.-->
    <PublishConfigurationPath>Properties\PublishConfigurationDev.xml</PublishConfigurationPath>
  </PropertyGroup>
</Project>
