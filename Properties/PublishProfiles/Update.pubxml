<?xml version="1.0" encoding="utf-8"?>
<!-- Releases after the first one. Requires ModId to be set in
     PublishConfiguration.xml, otherwise this creates a SECOND mod page.
     Note: the toolchain skips the build for Update, so build Release first. -->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <PublishDir>bin\Publish</PublishDir>
    <ModPublisherCommand>Update</ModPublisherCommand>
  </PropertyGroup>
</Project>
